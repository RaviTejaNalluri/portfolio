---
import type { Project } from '../data/projects';
type Props = { project: Project };
const { project } = Astro.props;
---

<article class="card">
	<h3>{project.title}</h3>
	<p>{project.description}</p>
	<ul class="tags">{project.tags.map((t) => <li>{t}</li>)}</ul>
	<div class="actions">
		{project.link && <a href={project.link} target="_blank" rel="noopener noreferrer">Live ↗</a>}
		{project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">Code ↗</a>}
	</div>
</article>
<style>
	.card {
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.25em 1.5em;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.card:hover {
		box-shadow: 0 8px 24px rgba(var(--gray), 20%);
		transform: translateY(-2px);
	}
	h3 {
		font-size: 1.25em;
		margin-bottom: 0.25em;
	}
	p {
		margin: 0 0 0.75em;
		font-size: 0.9em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		list-style: none;
		padding: 0;
		margin: 0 0 0.75em;
	}
	.tags li {
		font-size: 0.7em;
		background: rgb(var(--gray-light));
		border-radius: 999px;
		padding: 0.1em 0.75em;
	}
	.actions {
		display: flex;
		gap: 1em;
		font-size: 0.85em;
	}
</style>
