---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CertificationList from '../components/CertificationList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={`About ${AUTHOR.name}`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About me</h1>
			<!-- TODO: Replace with your own story -->
			<p>
				I'm {AUTHOR.name}, a {AUTHOR.role.toLowerCase()}. I have experience building large-scale backedn systems, distributed infrastructure,
				production automation, data platforms. I work extensively with building Cloud Infra, LLMs and GenAI based applications, Databases, Docker, Kuberenetes
							</p>
			<h2>Skills</h2>
			<ul>
				<li><strong>Languages:</strong> JavaScript, TypeScript, Python</li>
				<li><strong>Frameworks:</strong> React, Node.js</li>
				<li><strong>Tools:</strong> Git, Docker, AWS</li>
			</ul>
			<h2>Experience</h2>
			<ul>
				<li><strong>Software Development Engineer</strong> Amazon Web Services (2024–present)</li>
				<li><strong>Building infrastructure</strong> BroadPeak Partners (2024–present): what you did</li>
			</ul>
			<h2>Certifications</h2>
			<CertificationList />
			<h2>Get in touch</h2>
			<p>The best way to reach me is through any of these:</p>
			<SocialLinks />
			<!-- To add a resume: put resume.pdf in /public and link to /resume.pdf -->
		</main>
		<Footer />
	</body>
</html>
<style>
	h2 {
		font-size: 1.4em;
		margin-top: 1.5em;
	}
</style>
